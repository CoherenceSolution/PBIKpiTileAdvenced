{
    "Role_period": "Period",
    "Role_period_Desc": "Required. One row per period: a date, or a text/number such as 2026-01, Q1 2026, 2026.",
    "Role_periodSortKey": "Period Sort Key",
    "Role_periodSortKey_Desc": "Optional numeric or date key (e.g. 202601) from the same table as Period, used for chronological sorting.",
