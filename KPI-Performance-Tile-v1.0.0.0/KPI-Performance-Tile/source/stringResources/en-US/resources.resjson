    "Role_actualValue": "Actual Value",
    "Role_actualValue_Desc": "Recommended. Realised value per period, drawn as the main bar.",
    "Role_projectedValue": "Projected Value",
    "Role_projectedValue_Desc": "Optional projected total for the open period.",
    "Role_projectionRemaining": "Projection Remaining",
